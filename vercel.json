{
  "version": 2,
  "builds": [
    {
      "src": "Backend/clinic_core/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "Backend/clinic_core/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "clinic_core.settings",
    "DEBUG": "False",
    "SECRET_KEY": "vercel-production-secret-key-udbhav-clinic-2026",
    "ALLOWED_HOSTS": ".vercel.app,127.0.0.1,localhost"
  }
}
