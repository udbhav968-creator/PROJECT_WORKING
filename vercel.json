{
  "version": 2,
  "name": "project-working",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "clinic_core.settings",
    "DEBUG": "False",
    "SECRET_KEY": "vercel-production-secret-key-udbhav-clinic-2026",
    "ALLOWED_HOSTS": "*"
  }
}
