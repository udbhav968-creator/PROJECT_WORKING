					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/admin/appointments/{{appointment_id}}/slip/", "host": ["{{baseUrl}}"], "path": ["api", "admin", "appointments", "{{appointment_id}}", "slip", ""] }
