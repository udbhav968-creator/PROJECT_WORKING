						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"patient_name\": \"Udbhav Sharma\",\n  \"patient_phone\": \"+91 9811122233\",\n  \"patient_email\": \"udbhav@example.com\",\n  \"doctor_name\": \"Dr. Divit Shah\",\n  \"department\": \"General_Consultation\",\n  \"priority\": \"emergency\",\n  \"consultation_type\": \"Teleconsultation\",\n  \"consultation_fee_inr\": 600.00,\n  \"appointment_date\": \"2026-07-31T10:00:00Z\",\n  \"notes\": \"Emergency telemedicine consultation\"\n}"
						},
