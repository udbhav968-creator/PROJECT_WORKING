					"name": "List OPD Appointments (/api/admin/appointments/)",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/admin/appointments/?status=scheduled", "host": ["{{baseUrl}}"], "path": ["api", "admin", "appointments", ""], "query": [{"key": "status", "value": "scheduled"}] }
					}
				},
