{
    "info": {
        "_postman_id": "udbhav-module4-final-2026",
        "name": "🏥 Healthcare Clinic API – Udbhav Module 4 (Admin & Integration)",
        "description": "Complete Postman Collection for Module 4: Administration & System Integration.\n\n**Endpoints covered:**\n- JWT Authentication\n- System Health Check\n- Admin Dashboard Analytics\n- Audit Log List (paginated)\n- Demo Data Seeding\n\n**Base URL:** http://127.0.0.1:8000",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "🔐 Authentication",
            "item": [
                {
                    "name": "Obtain JWT Access Token",
                    "request": {
                        "method": "POST",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"adminpassword\"\n}"
                        },
                        "url": {
                            "raw": "http://127.0.0.1:8000/api/token/",
                            "protocol": "http",
                            "host": ["127", "0", "0", "1"],
                            "port": "8000",
                            "path": ["api", "token", ""]
                        }
                    }
                },
                {
                    "name": "Refresh JWT Token",
                    "request": {
                        "method": "POST",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"refresh\": \"<your_refresh_token_here>\"\n}"
                        },
                        "url": {
                            "raw": "http://127.0.0.1:8000/api/token/refresh/",
                            "protocol": "http",
                            "host": ["127", "0", "0", "1"],
                            "port": "8000",
                            "path": ["api", "token", "refresh", ""]
                        }
                    }
                }
            ]
        },
        {
            "name": "⚙️ System Integration",
            "item": [
                {
                    "name": "System Health Check",
                    "request": {
                        "method": "GET",
                        "header": [],
