		{
			"name": "Module 1: Authentication & User Management",
			"item": [
				{
					"name": "User Registration (/api/auth/register/)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"dr_divit\",\n  \"email\": \"divit.shah@purehealthclinic.com\",\n  \"password\": \"PureHealth@2026!\",\n  \"full_name\": \"Dr. Divit Shah\",\n  \"role_name\": \"Doctor\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/auth/register/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register", ""] }
					}
				},
				{
					"name": "User Login & JWT Acquisition (/api/auth/login/)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"dr_divit\",\n  \"password\": \"PureHealth@2026!\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/auth/login/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login", ""] }
					}
				},
				{
					"name": "User Profile (/api/auth/profile/)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_access_token}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/auth/profile/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "profile", ""] }
					}
				}
			]
		},
		{
